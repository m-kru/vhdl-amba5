namespace eval vhdl::amba5::apb {
  namespace eval pkg {
    set doc "APB package with all primary types and functions."

    proc src {} {
      hbs::AddDep vhdl::amba5::string::src
      hbs::SetLib "amba5_apb"
      hbs::AddFile apb.vhd
    }

    proc _tb {top} {
      hbs::SetTool "nvc"
      if {$hbs::Tool eq "nvc"} {
        hbs::AddPreSimCb hbs::SetArgPrefix "--messages=compact"
      }
      hbs::SetTop $top
      src
      hbs::SetLib ""
    }

    # Testbench for protection_t functions.
    proc tb_prot_funcs {} {
      _tb "tb_prot_funcs"
      hbs::AddFile tb/tb_prot_funcs.vhd
      hbs::Run
    }

    # Testbench for various util functions.
    proc tb_util_funcs {} {
      _tb "tb_util_funcs"
      hbs::AddFile tb/tb_util_funcs.vhd
      hbs::Run
    }

    hbs::Register $doc
  }

